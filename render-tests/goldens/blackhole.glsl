//--- library: glsl/shapes/sphere.glsl ---
//----------------------------------------------------------------------------
// SPHERE
//
// glsl/shapes/ is the math-only library: plain functions of a point and some
// floats. No structs, no Frame, no Material, no at()/inside()/setData().
// Placement, materials and the region interface are emitted by the scene.
//----------------------------------------------------------------------------


// p is in the sphere's own coordinates (origin at the centre)
float sphereDistance(vec3 p, float radius){
    return length(p) - radius;
}


// Exact ray intersection, in world coordinates: the distance along tv to the
// sphere, or maxDist if it is not in front of us. tv.dir is unit length.
//
// A ray STARTING INSIDE takes the far root — glass needs that, since a
// transmitted ray has to find the far wall of the object it just entered.
float sphereTrace(Vector tv, vec3 centre, float radius){
    vec3  oc = tv.pos - centre;
    float b  = dot(oc, tv.dir);
    float c  = dot(oc, oc) - radius*radius;
    float disc = b*b - c;
    if(disc < 0.){ return maxDist; }

    float s = sqrt(disc);
    float t = -b - s;
    if(t < 0.){ t = -b + s; }
    if(t < 0.){ return maxDist; }
    return min(t, maxDist);
}


//--- the objects, in declaration order (= containment priority, inner to outer)
const int ID_SPACE = 0;

const int N_OBJ = 1;
float gSDF[N_OBJ];


//--- placement and shape parameters ----------------------------------
const vec3  SPACE_P      = vec3(0.0);
const float SPACE_RADIUS = 40.0;


//---------------------------------------------------------------------
// the media — a per-region varying index the ODE marcher bends light through
//---------------------------------------------------------------------

float indexField_space(vec3 q){
    return pow(1.0 + mass/max(length(q), 1e-4), 2.0);
}

bool isMedium(int id){ return id == ID_SPACE; }

float indexFieldOf(int id, vec3 p){
    if(id == ID_SPACE){ return indexField_space(p - SPACE_P); }
    return 1.0;   //not a medium: vacuum
}


//---------------------------------------------------------------------
// the region sdfs
//---------------------------------------------------------------------

float sdf_space(vec3 p){
    return sphereDistance(p - SPACE_P, SPACE_RADIUS);
}


//---------------------------------------------------------------------
// the normals — the 4-tap of each region's own sdf, in world coordinates
//---------------------------------------------------------------------
const float NRM_E = 0.0002;

Vector normal_space(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_space(p + k.xyy*NRM_E) + k.yyx*sdf_space(p + k.yyx*NRM_E)
                              + k.yxy*sdf_space(p + k.yxy*NRM_E) + k.xxx*sdf_space(p + k.xxx*NRM_E) ));
}


//---------------------------------------------------------------------
// the materials
//  material_ gives the Surface plus this object's own Medium; medium_ gives
//  only the Medium, for when the object is merely the far side
//---------------------------------------------------------------------

Medium medium_space(vec3 p){
    Medium m = defaultMedium();
    m.ior    = indexField_space(p - SPACE_P);
    m.absorb = vec3(0.0);
    return m;
}
Material material_space(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //glass
    m.interior = medium_space(p);
    m.surf.transmit = 1.0;
    return m;
}


//---------------------------------------------------------------------
// the dispatchers
//---------------------------------------------------------------------

void sdfAll(vec3 p){
    gSDF[ID_SPACE] = sdf_space(p);
}

Vector normalOf(int id, vec3 p){

    return normal_space(p);
}

//no sheets in this scene: every object is a region with an interior
bool isSheet(int id){ return false; }

Material materialOf(int id, vec3 p, inout Vector n, bool front){

    return material_space(p, n);
}

Medium mediumOf(int id, vec3 p){
    if(id == ID_SPACE){ return medium_space(p); }
    return defaultMedium();      //ID_NONE: open air
}


//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    d = min(d, sdf_space(p));

    return d;
}

float trace_Scene(Vector tv){
    return maxDist;
}
