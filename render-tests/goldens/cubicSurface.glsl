//---------------------------------------------------------------------
// the materials
//  material_ gives the Surface plus this object's own Medium; medium_ gives
//  only the Medium, for when the object is merely the far side
//---------------------------------------------------------------------

Medium medium_surface(vec3 p){
    Medium m = defaultMedium();
    m.ior    = 1.5;
    m.absorb = vec3(0.5, 0.3, 0.1);
    return m;
}
Material material_surface(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //glass
    m.interior = medium_surface(p);
    m.surf.transmit = 1.0;
    return m;
}

Material material_pairs(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //metal
    m.surf.diffuse   = vec3(0.55);
    m.surf.specular  = vec3(0.55);
    m.surf.roughness = 0.1;
    m.surf.gloss     = 0.8;
    return m;
}
Medium   medium_pairs  (vec3 p){ return defaultMedium(); }

Material material_conics(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //metal
    m.surf.diffuse   = vec3(0.2, 0.45, 0.9);
    m.surf.specular  = vec3(0.2, 0.45, 0.9);
    m.surf.roughness = 0.1;
    m.surf.gloss     = 0.8;
    return m;
}
Medium   medium_conics  (vec3 p){ return defaultMedium(); }

Material material_exceptional(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //metal
    m.surf.diffuse   = vec3(0.9, 0.25, 0.2);
    m.surf.specular  = vec3(0.9, 0.25, 0.2);
    m.surf.roughness = 0.1;
    m.surf.gloss     = 0.8;
    return m;
}
Medium   medium_exceptional  (vec3 p){ return defaultMedium(); }

Material material_ring(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //metal
    m.surf.diffuse   = vec3(0.1);
    m.surf.specular  = vec3(0.1);
    m.surf.roughness = 0.2;
    m.surf.gloss     = 0.6;
    return m;
}
Medium   medium_ring  (vec3 p){ return defaultMedium(); }

Material material_key(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //light
    m.surf.emit = 60.0*vec3(1.0);
    return m;
}
Medium   medium_key  (vec3 p){ return defaultMedium(); }

Material material_room(vec3 p, inout Vector n){
    vec3 q = p - ROOM_P;
    int faceData = roomFaceData(q, ROOM_HALFSIZE);
    if(faceData == ROOM_CEILING){ return makeLight(vec3(1.0), roomLight); }
    if(faceData == ROOM_FLOOR)  { return makeGloss(floorColor, 0.0, wallRough); }
    if(faceData == ROOM_LEFT)   { return makeGloss(warmColor,  0.0, wallRough); }
    if(faceData == ROOM_RIGHT)  { return makeGloss(coolColor,  0.0, wallRough); }
    return makeGloss(wallColor, 0.0, wallRough);
}
Medium medium_room(vec3 p){ return defaultMedium(); }


//---------------------------------------------------------------------
// the analytic intersections
//---------------------------------------------------------------------

float trace_key(Vector tv){
    return sphereTrace(tv, KEY_P, KEY_RADIUS);
}

float trace_room(Vector tv){
    return roomTrace(tv, ROOM_P, ROOM_HALFSIZE);
}


//---------------------------------------------------------------------
// the dispatchers
//---------------------------------------------------------------------

void sdfAll(vec3 p){
    sdf_cubic(p, gSDF[ID_SURFACE], gSDF[ID_PAIRS], gSDF[ID_CONICS], gSDF[ID_EXCEPTIONAL], gSDF[ID_RING]);
    gSDF[ID_KEY        ] = sdf_key(p);
    gSDF[ID_ROOM       ] = sdf_room(p);
}

Vector normalOf(int id, vec3 p){
    if(id == ID_SURFACE    ){ return normal_surface(p); }
    if(id == ID_PAIRS      ){ return normal_pairs(p); }
    if(id == ID_CONICS     ){ return normal_conics(p); }
    if(id == ID_EXCEPTIONAL){ return normal_exceptional(p); }
    if(id == ID_RING       ){ return normal_ring(p); }
    if(id == ID_KEY        ){ return normal_key(p); }
    return normal_room(p);
}

//no sheets in this scene: every object is a region with an interior
bool isSheet(int id){ return false; }

Material materialOf(int id, vec3 p, inout Vector n, bool front){
    if(id == ID_SURFACE    ){ return material_surface(p, n); }
    if(id == ID_PAIRS      ){ return material_pairs(p, n); }
    if(id == ID_CONICS     ){ return material_conics(p, n); }
    if(id == ID_EXCEPTIONAL){ return material_exceptional(p, n); }
    if(id == ID_RING       ){ return material_ring(p, n); }
    if(id == ID_KEY        ){ return material_key(p, n); }
    return material_room(p, n);
}

Medium mediumOf(int id, vec3 p){
    if(id == ID_SURFACE    ){ return medium_surface(p); }
    if(id == ID_PAIRS      ){ return medium_pairs(p); }
    if(id == ID_CONICS     ){ return medium_conics(p); }
    if(id == ID_EXCEPTIONAL){ return medium_exceptional(p); }
    if(id == ID_RING       ){ return medium_ring(p); }
    if(id == ID_KEY        ){ return medium_key(p); }
    if(id == ID_ROOM       ){ return medium_room(p); }
    return defaultMedium();      //ID_NONE: open air
}


//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    float b_cubic = bound_cubic(p);
    if(b_cubic > BOUND_MARGIN){ d = min(d, b_cubic); }
    else{
        float surface, pairs, conics, exceptional, ring;
        sdf_cubic(p, surface, pairs, conics, exceptional, ring);
        d = min(d, min(min(min(min(surface, pairs), conics), exceptional), ring));
    }

    return d;
}

float trace_Scene(Vector tv){
    float d = maxDist;
    d = min(d, trace_key(tv));
    d = min(d, trace_room(tv));
    return d;
}
