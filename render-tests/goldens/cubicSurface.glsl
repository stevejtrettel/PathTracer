float cubicF(vec3 p){
    float x = p.x, y = p.y, z = p.z;
    float x2 = x*x, y2 = y*y, z2 = z*z;

    return C[0]*x2*x   + C[1]*x2*y   + C[2]*x2*z   + C[3]*x2
         + C[4]*x*y2   + C[5]*x*y*z  + C[6]*x*y    + C[7]*x*z2
         + C[8]*x*z    + C[9]*x
         + C[10]*y2*y  + C[11]*y2*z  + C[12]*y2    + C[13]*y*z2
         + C[14]*y*z   + C[15]*y
         + C[16]*z2*z  + C[17]*z2    + C[18]*z     + C[19];
}

vec3 cubicGrad(vec3 p){
    float x = p.x, y = p.y, z = p.z;
    float x2 = x*x, y2 = y*y, z2 = z*z;

    float dx = 3.0*C[0]*x2   + 2.0*C[1]*x*y   + 2.0*C[2]*x*z + 2.0*C[3]*x
             +     C[4]*y2   +     C[5]*y*z   +     C[6]*y   +     C[7]*z2
             +     C[8]*z    +     C[9];

    float dy =     C[1]*x2   + 2.0*C[4]*x*y   +     C[5]*x*z +     C[6]*x
             + 3.0*C[10]*y2  + 2.0*C[11]*y*z  + 2.0*C[12]*y  +     C[13]*z2
             +     C[14]*z   +     C[15];

    float dz =     C[2]*x2   +     C[5]*x*y   + 2.0*C[7]*x*z +     C[8]*x
             +     C[11]*y2  + 2.0*C[13]*y*z  +     C[14]*y
             + 3.0*C[16]*z2  + 2.0*C[17]*z    +     C[18];

    return vec3(dx, dy, dz);
}

//nearest of a line class, already tubed (lineDistance is primitives/line.glsl)
float cubicPairDist(vec3 p, float r){
    float d = 1.0e6;
    for(int i = 0; i < 15; i++){ d = min(d, lineDistance(p, PAIR_LINES[i].point, PAIR_LINES[i].dir, r)); }
    return d;
}
float cubicConicDist(vec3 p, float r){
    float d = 1.0e6;
    for(int i = 0; i < 6; i++){ d = min(d, lineDistance(p, CONIC_LINES[i].point, CONIC_LINES[i].dir, r)); }
    return d;
}
float cubicExceptionalDist(vec3 p, float r){
    float d = 1.0e6;
    for(int i = 0; i < 6; i++){ d = min(d, lineDistance(p, EXCEPTIONAL_LINES[i].point, EXCEPTIONAL_LINES[i].dir, r)); }
    return d;
}


//--- the objects, in declaration order (= containment priority, inner to outer)
const int ID_SURFACE     = 0;
const int ID_PAIRS       = 1;
const int ID_CONICS      = 2;
const int ID_EXCEPTIONAL = 3;
const int ID_RING        = 4;
const int ID_KEY         = 5;
const int ID_ROOM        = 6;

const int N_OBJ = 7;
float gSDF[N_OBJ];


//--- placement and shape parameters ----------------------------------
const vec3 CUBIC_P = vec3(0.0);
const float CUBIC_BALL   = 2.0;    //the sphere the whole figure is cut to
const float CUBIC_ZOOM   = 1.0;    //the surface's internal scale
const float CUBIC_BLEND  = 0.05;   //how softly the surface meets the cut

const vec3  KEY_P      = vec3(-12.0, 8.0, 2.0);
const float KEY_RADIUS = 1.5;

const vec3 ROOM_P        = vec3(-5.75, 5.75, -3.0);
const vec3 ROOM_HALFSIZE = vec3(14.25, 8.25, 17.0);


//---------------------------------------------------------------------
// the region sdfs
//---------------------------------------------------------------------

void sdf_cubic(vec3 p, out float surface, out float pairs, out float conics, out float exceptional, out float ring){
    vec3  q = p - CUBIC_P;
    float ball = length(q) - CUBIC_BALL;
    vec3  s    = CUBIC_ZOOM*q;
    float val  = cubicF(s);
    vec3  grad = cubicGrad(s)*CUBIC_ZOOM;

    //the surface: a first-order distance estimate to {cubic = 0},
    //thickened into a shell, then cut to the ball
    float de = val/(length(grad) + 0.001);
    surface  = smax(abs(de + shellDepth) - shellDepth, ball, CUBIC_BLEND);

    //the 27 lines, by class, each cut to the same ball
    pairs       = max(cubicPairDist(q, lineRadius), ball);
    conics      = max(cubicConicDist(q, lineRadius), ball);
    exceptional = max(cubicExceptionalDist(q, lineRadius), ball);

    //the ring where the surface leaves the ball: a tube around the
    //curve {cubic = 0} ∩ {ball = 0}. The sphere's gradient is just
    //its radial direction (ops/curve.glsl).
    ring = opCurveTube(val, grad, ball, normalize(q), ringRadius);
}

//single-region entry points, for the 4-tap normals
float sdf_surface(vec3 p){ float surface, pairs, conics, exceptional, ring; sdf_cubic(p, surface, pairs, conics, exceptional, ring); return surface; }
float sdf_pairs(vec3 p){ float surface, pairs, conics, exceptional, ring; sdf_cubic(p, surface, pairs, conics, exceptional, ring); return pairs; }
float sdf_conics(vec3 p){ float surface, pairs, conics, exceptional, ring; sdf_cubic(p, surface, pairs, conics, exceptional, ring); return conics; }
float sdf_exceptional(vec3 p){ float surface, pairs, conics, exceptional, ring; sdf_cubic(p, surface, pairs, conics, exceptional, ring); return exceptional; }
float sdf_ring(vec3 p){ float surface, pairs, conics, exceptional, ring; sdf_cubic(p, surface, pairs, conics, exceptional, ring); return ring; }

float sdf_key(vec3 p){
    return sphereDistance(p - KEY_P, KEY_RADIUS);
}

//the room SOLID is everything outside the box, so its interior is open air and
//regionAt() returns ID_NONE there
float sdf_room(vec3 p){
    return roomDistance(p - ROOM_P, ROOM_HALFSIZE);
}


//---------------------------------------------------------------------
// the bounds — the acceleration structure (sdf_Scene only; sdfAll stays exact)
//---------------------------------------------------------------------

float bound_cubic(vec3 p){
    vec3 q = p - CUBIC_P;
    return length(q) - 2.5;
}


//---------------------------------------------------------------------
// the normals — the 4-tap of each region's own sdf, in world coordinates
//---------------------------------------------------------------------
const float NRM_E = 0.0002;

Vector normal_surface(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_surface(p + k.xyy*NRM_E) + k.yyx*sdf_surface(p + k.yyx*NRM_E)
                              + k.yxy*sdf_surface(p + k.yxy*NRM_E) + k.xxx*sdf_surface(p + k.xxx*NRM_E) ));
}

Vector normal_pairs(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_pairs(p + k.xyy*NRM_E) + k.yyx*sdf_pairs(p + k.yyx*NRM_E)
                              + k.yxy*sdf_pairs(p + k.yxy*NRM_E) + k.xxx*sdf_pairs(p + k.xxx*NRM_E) ));
}

Vector normal_conics(vec3 p){
