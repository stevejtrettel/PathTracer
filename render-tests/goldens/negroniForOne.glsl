void sdfAll(vec3 p){
    sdf_negroni(p, gSDF[ID_NEGRONIGLASS], gSDF[ID_NEGRONI]);
    sdf_ginBottle(p, gSDF[ID_GINGLASS], gSDF[ID_GIN]);
    sdf_campariBottle(p, gSDF[ID_CAMPARIGLASS], gSDF[ID_CAMPARI]);
    sdf_vermouthBottle(p, gSDF[ID_VERMOUTHGLASS], gSDF[ID_VERMOUTH]);
    gSDF[ID_LIGHT        ] = sdf_light(p);
    gSDF[ID_ROOM         ] = sdf_room(p);
}

Vector normalOf(int id, vec3 p){
    if(id == ID_NEGRONIGLASS ){ return normal_negroniGlass(p); }
    if(id == ID_NEGRONI      ){ return normal_negroni(p); }
    if(id == ID_GINGLASS     ){ return normal_ginGlass(p); }
    if(id == ID_GIN          ){ return normal_gin(p); }
    if(id == ID_CAMPARIGLASS ){ return normal_campariGlass(p); }
    if(id == ID_CAMPARI      ){ return normal_campari(p); }
    if(id == ID_VERMOUTHGLASS){ return normal_vermouthGlass(p); }
    if(id == ID_VERMOUTH     ){ return normal_vermouth(p); }
    if(id == ID_LIGHT        ){ return normal_light(p); }
    return normal_room(p);
}

//no sheets in this scene: every object is a region with an interior
bool isSheet(int id){ return false; }

Material materialOf(int id, vec3 p, inout Vector n, bool front){
    if(id == ID_NEGRONIGLASS ){ return material_negroniGlass(p, n); }
    if(id == ID_NEGRONI      ){ return material_negroni(p, n); }
    if(id == ID_GINGLASS     ){ return material_ginGlass(p, n); }
    if(id == ID_GIN          ){ return material_gin(p, n); }
    if(id == ID_CAMPARIGLASS ){ return material_campariGlass(p, n); }
    if(id == ID_CAMPARI      ){ return material_campari(p, n); }
    if(id == ID_VERMOUTHGLASS){ return material_vermouthGlass(p, n); }
    if(id == ID_VERMOUTH     ){ return material_vermouth(p, n); }
    if(id == ID_LIGHT        ){ return material_light(p, n); }
    return material_room(p, n);
}

Medium mediumOf(int id, vec3 p){
    if(id == ID_NEGRONIGLASS ){ return medium_negroniGlass(p); }
    if(id == ID_NEGRONI      ){ return medium_negroni(p); }
    if(id == ID_GINGLASS     ){ return medium_ginGlass(p); }
    if(id == ID_GIN          ){ return medium_gin(p); }
    if(id == ID_CAMPARIGLASS ){ return medium_campariGlass(p); }
    if(id == ID_CAMPARI      ){ return medium_campari(p); }
    if(id == ID_VERMOUTHGLASS){ return medium_vermouthGlass(p); }
    if(id == ID_VERMOUTH     ){ return medium_vermouth(p); }
    if(id == ID_LIGHT        ){ return medium_light(p); }
    if(id == ID_ROOM         ){ return medium_room(p); }
    return defaultMedium();      //ID_NONE: open air
}


//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    float b_negroni = bound_negroni(p);
    if(b_negroni > BOUND_MARGIN){ d = min(d, b_negroni); }
    else{
        float negroniGlass, negroni;
        sdf_negroni(p, negroniGlass, negroni);
        d = min(d, min(negroniGlass, negroni));
    }

    float b_ginBottle = bound_ginBottle(p);
    if(b_ginBottle > BOUND_MARGIN){ d = min(d, b_ginBottle); }
    else{
        float ginGlass, gin;
        sdf_ginBottle(p, ginGlass, gin);
        d = min(d, min(ginGlass, gin));
    }

    float b_campariBottle = bound_campariBottle(p);
    if(b_campariBottle > BOUND_MARGIN){ d = min(d, b_campariBottle); }
    else{
        float campariGlass, campari;
        sdf_campariBottle(p, campariGlass, campari);
        d = min(d, min(campariGlass, campari));
    }

    float b_vermouthBottle = bound_vermouthBottle(p);
    if(b_vermouthBottle > BOUND_MARGIN){ d = min(d, b_vermouthBottle); }
    else{
        float vermouthGlass, vermouth;
        sdf_vermouthBottle(p, vermouthGlass, vermouth);
        d = min(d, min(vermouthGlass, vermouth));
    }

    return d;
}

float trace_Scene(Vector tv){
    float d = maxDist;
    d = min(d, trace_light(tv));
    d = min(d, trace_room(tv));
    return d;
}
