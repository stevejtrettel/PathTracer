void sdfAll(vec3 p){
    gSDF[ID_BALL0] = sdf_ball0(p);
    gSDF[ID_BALL1] = sdf_ball1(p);
    gSDF[ID_BALL2] = sdf_ball2(p);
    gSDF[ID_BALL3] = sdf_ball3(p);
    gSDF[ID_BALL4] = sdf_ball4(p);
    gSDF[ID_BALL5] = sdf_ball5(p);
    gSDF[ID_BALL6] = sdf_ball6(p);
    gSDF[ID_DEEP0] = sdf_deep0(p);
    gSDF[ID_DEEP1] = sdf_deep1(p);
    gSDF[ID_DEEP2] = sdf_deep2(p);
    gSDF[ID_DEEP3] = sdf_deep3(p);
    gSDF[ID_FLOOR] = sdf_floor(p);
    gSDF[ID_KEY  ] = sdf_key(p);
    gSDF[ID_ROOM ] = sdf_room(p);
}

Vector normalOf(int id, vec3 p){
    if(id == ID_BALL0){ return normal_ball0(p); }
    if(id == ID_BALL1){ return normal_ball1(p); }
    if(id == ID_BALL2){ return normal_ball2(p); }
    if(id == ID_BALL3){ return normal_ball3(p); }
    if(id == ID_BALL4){ return normal_ball4(p); }
    if(id == ID_BALL5){ return normal_ball5(p); }
    if(id == ID_BALL6){ return normal_ball6(p); }
