Medium mediumOf(int id, vec3 p){
    if(id == ID_BALL0){ return medium_ball0(p); }
    if(id == ID_BALL1){ return medium_ball1(p); }
    if(id == ID_BALL2){ return medium_ball2(p); }
    if(id == ID_BALL3){ return medium_ball3(p); }
    if(id == ID_BALL4){ return medium_ball4(p); }
