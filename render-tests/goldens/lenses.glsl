    if(id == ID_BALL0){ return material_ball0(p, n); }
    if(id == ID_BALL1){ return material_ball1(p, n); }
    if(id == ID_BALL2){ return material_ball2(p, n); }
    if(id == ID_BALL3){ return material_ball3(p, n); }
