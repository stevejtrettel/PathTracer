    if(id == ID_DEEP1){ return normal_deep1(p); }
    if(id == ID_DEEP2){ return normal_deep2(p); }
    if(id == ID_DEEP3){ return normal_deep3(p); }
    if(id == ID_FLOOR){ return normal_floor(p); }
    if(id == ID_KEY  ){ return normal_key(p); }
    return normal_room(p);
}

