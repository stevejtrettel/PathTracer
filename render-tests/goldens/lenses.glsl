//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

//nothing marches: every surface here has a closed-form intersection
float sdf_Scene(Vector tv){
    return maxDist;
}

float trace_Scene(Vector tv){
    float d = maxDist;
    d = min(d, trace_ball0(tv));
    d = min(d, trace_ball1(tv));
    d = min(d, trace_ball2(tv));
    d = min(d, trace_ball3(tv));
    d = min(d, trace_ball4(tv));
    d = min(d, trace_ball5(tv));
    d = min(d, trace_ball6(tv));
    d = min(d, trace_deep0(tv));
    d = min(d, trace_deep1(tv));
    d = min(d, trace_deep2(tv));
    d = min(d, trace_deep3(tv));
    d = min(d, trace_floor(tv));
    d = min(d, trace_key(tv));
    d = min(d, trace_room(tv));
    return d;
}


