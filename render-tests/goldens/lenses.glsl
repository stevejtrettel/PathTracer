    if(id == ID_DEEP0){ return medium_deep0(p); }
    if(id == ID_DEEP1){ return medium_deep1(p); }
    if(id == ID_DEEP2){ return medium_deep2(p); }
    if(id == ID_DEEP3){ return medium_deep3(p); }
    if(id == ID_FLOOR){ return medium_floor(p); }
    if(id == ID_KEY  ){ return medium_key(p); }
