//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    d = min(d, sdf_tetra(p));

    float b_octa = bound_octa(p);
    d = min(d, (b_octa > BOUND_MARGIN) ? b_octa : sdf_octa(p));

    float b_dodeca = bound_dodeca(p);
    d = min(d, (b_dodeca > BOUND_MARGIN) ? b_dodeca : sdf_dodeca(p));

    float b_icosa = bound_icosa(p);
    d = min(d, (b_icosa > BOUND_MARGIN) ? b_icosa : sdf_icosa(p));

    d = min(d, sdf_cone(p));

    d = min(d, sdf_cyl(p));

    d = min(d, sdf_torus(p));

    d = min(d, sdf_caps(p));

    float b_egg = bound_egg(p);
    d = min(d, (b_egg > BOUND_MARGIN) ? b_egg : sdf_egg(p));

    d = min(d, sdf_frame(p));

    float b_hour = bound_hour(p);
    d = min(d, (b_hour > BOUND_MARGIN) ? b_hour : sdf_hour(p));

    return d;
}

float trace_Scene(Vector tv){
    float d = maxDist;
    d = min(d, trace_key(tv));
    d = min(d, trace_room(tv));
    return d;
}
