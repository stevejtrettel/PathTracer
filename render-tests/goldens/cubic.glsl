Material material_key(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //light
    m.surf.emit = 60.0*vec3(1.0);
    return m;
}
Medium   medium_key  (vec3 p){ return defaultMedium(); }

Material material_room(vec3 p, inout Vector n){
    vec3 q = p - ROOM_P;
    int faceData = roomFaceData(q, ROOM_HALFSIZE);
    if(faceData == ROOM_CEILING){ return makeLight(vec3(1.0), roomLight); }
    if(faceData == ROOM_FLOOR)  { return makeGloss(floorColor, 0.0, wallRough); }
    if(faceData == ROOM_LEFT)   { return makeGloss(warmColor,  0.0, wallRough); }
    if(faceData == ROOM_RIGHT)  { return makeGloss(coolColor,  0.0, wallRough); }
    return makeGloss(wallColor, 0.0, wallRough);
}
Medium medium_room(vec3 p){ return defaultMedium(); }


//---------------------------------------------------------------------
// the analytic intersections
//---------------------------------------------------------------------

float trace_key(Vector tv){
    return sphereTrace(tv, KEY_P, KEY_RADIUS);
}

float trace_room(Vector tv){
    return roomTrace(tv, ROOM_P, ROOM_HALFSIZE);
}


//---------------------------------------------------------------------
// the dispatchers
//---------------------------------------------------------------------

void sdfAll(vec3 p){
    sdf_surfaceGroup(p, gSDF[ID_SURFACE], gSDF[ID_PAIRLINES], gSDF[ID_CONICLINES], gSDF[ID_EXCEPTIONALLINES], gSDF[ID_RING]);
    sdf_plateGroup(p, gSDF[ID_PLATE], gSDF[ID_CHECKERS], gSDF[ID_PLATELINES], gSDF[ID_PLATECONICS]);
    gSDF[ID_KEY             ] = sdf_key(p);
    gSDF[ID_ROOM            ] = sdf_room(p);
}

Vector normalOf(int id, vec3 p){
    if(id == ID_SURFACE         ){ return normal_surface(p); }
    if(id == ID_PAIRLINES       ){ return normal_pairLines(p); }
    if(id == ID_CONICLINES      ){ return normal_conicLines(p); }
    if(id == ID_EXCEPTIONALLINES){ return normal_exceptionalLines(p); }
    if(id == ID_RING            ){ return normal_ring(p); }
    if(id == ID_PLATE           ){ return normal_plate(p); }
    if(id == ID_CHECKERS        ){ return normal_checkers(p); }
    if(id == ID_PLATELINES      ){ return normal_plateLines(p); }
    if(id == ID_PLATECONICS     ){ return normal_plateConics(p); }
    if(id == ID_KEY             ){ return normal_key(p); }
    return normal_room(p);
}

//no sheets in this scene: every object is a region with an interior
bool isSheet(int id){ return false; }

Material materialOf(int id, vec3 p, inout Vector n, bool front){
    if(id == ID_SURFACE         ){ return material_surface(p, n); }
    if(id == ID_PAIRLINES       ){ return material_pairLines(p, n); }
    if(id == ID_CONICLINES      ){ return material_conicLines(p, n); }
    if(id == ID_EXCEPTIONALLINES){ return material_exceptionalLines(p, n); }
    if(id == ID_RING            ){ return material_ring(p, n); }
    if(id == ID_PLATE           ){ return material_plate(p, n); }
    if(id == ID_CHECKERS        ){ return material_checkers(p, n); }
    if(id == ID_PLATELINES      ){ return material_plateLines(p, n); }
    if(id == ID_PLATECONICS     ){ return material_plateConics(p, n); }
    if(id == ID_KEY             ){ return material_key(p, n); }
    return material_room(p, n);
}

Medium mediumOf(int id, vec3 p){
    if(id == ID_SURFACE         ){ return medium_surface(p); }
    if(id == ID_PAIRLINES       ){ return medium_pairLines(p); }
    if(id == ID_CONICLINES      ){ return medium_conicLines(p); }
    if(id == ID_EXCEPTIONALLINES){ return medium_exceptionalLines(p); }
    if(id == ID_RING            ){ return medium_ring(p); }
    if(id == ID_PLATE           ){ return medium_plate(p); }
    if(id == ID_CHECKERS        ){ return medium_checkers(p); }
    if(id == ID_PLATELINES      ){ return medium_plateLines(p); }
    if(id == ID_PLATECONICS     ){ return medium_plateConics(p); }
    if(id == ID_KEY             ){ return medium_key(p); }
    if(id == ID_ROOM            ){ return medium_room(p); }
    return defaultMedium();      //ID_NONE: open air
}


//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    float b_surfaceGroup = bound_surfaceGroup(p);
    if(b_surfaceGroup > BOUND_MARGIN){ d = min(d, b_surfaceGroup); }
    else{
        float surface, pairLines, conicLines, exceptionalLines, ring;
        sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring);
        d = min(d, min(min(min(min(surface, pairLines), conicLines), exceptionalLines), ring));
    }

    float b_plateGroup = bound_plateGroup(p);
    if(b_plateGroup > BOUND_MARGIN){ d = min(d, b_plateGroup); }
    else{
        float plate, checkers, plateLines, plateConics;
        sdf_plateGroup(p, plate, checkers, plateLines, plateConics);
        d = min(d, min(min(min(plate, checkers), plateLines), plateConics));
    }

    return d;
}

float trace_Scene(Vector tv){
    float d = maxDist;
    d = min(d, trace_key(tv));
    d = min(d, trace_room(tv));
    return d;
}
