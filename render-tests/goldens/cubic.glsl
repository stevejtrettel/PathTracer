//--- placement and shape parameters ----------------------------------
const vec3 SURFACEGROUP_P = vec3(3.5, 0.0, 0.0);
const float CUBIC_BALL  = 2.0;
const float CUBIC_ZOOM  = 1.0;
const float CUBIC_SHELL = 0.01;   //inward shell depth
const float CUBIC_BLEND = 0.05;
const float CUBIC_LINE  = 0.02;
const float CUBIC_RING  = 0.05;

const vec3 PLATEGROUP_P = vec3(-1.0, -2.4, 0.0);
const float PLATE_HALF  = 1.2;
const float PLATE_THICK = 0.05;
const float PLATE_ROUND = 0.02;
const float PLATE_TOP   = 0.05;
const float PLATE_CURVE = 0.02;
const float CHECK_R     = 0.06;
const float CHECK_HALF  = 0.02;
const float CHECK_ROUND = 0.008;
const float CHECK_Y     = 0.07;

const vec3  KEY_P      = vec3(-12.0, 8.0, 2.0);
const float KEY_RADIUS = 1.5;

const vec3 ROOM_P        = vec3(0.0, 5.75, -5.0);
const vec3 ROOM_HALFSIZE = vec3(20.0, 8.25, 15.0);


//---------------------------------------------------------------------
// the region sdfs
//---------------------------------------------------------------------

void sdf_surfaceGroup(vec3 p, out float surface, out float pairLines, out float conicLines, out float exceptionalLines, out float ring){
    vec3  q = p - SURFACEGROUP_P;
    //the group's spin. No normal fixup follows: normals are a 4-tap
    //of the world sdf, so the chain rule carries this for free.
    vec3 t = cubicSpin(q, rotation);

    float ball = length(t) - CUBIC_BALL;
    vec3  s    = CUBIC_ZOOM*t;
    float val  = cubicF(s);
    vec3  grad = cubicGrad(s)*CUBIC_ZOOM;

    float de = val/(length(grad) + 0.001);
    surface  = smax(abs(de + CUBIC_SHELL) - CUBIC_SHELL, ball, CUBIC_BLEND);

    pairLines       = max(cubicPairDist(t, CUBIC_LINE), ball);
    conicLines      = max(cubicConicDist(t, CUBIC_LINE), ball);
    exceptionalLines = max(cubicExceptionalDist(t, CUBIC_LINE), ball);

    ring = opCurveTube(val, grad, ball, normalize(t), CUBIC_RING);
}

//single-region entry points, for the 4-tap normals
float sdf_surface(vec3 p){ float surface, pairLines, conicLines, exceptionalLines, ring; sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring); return surface; }
float sdf_pairLines(vec3 p){ float surface, pairLines, conicLines, exceptionalLines, ring; sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring); return pairLines; }
float sdf_conicLines(vec3 p){ float surface, pairLines, conicLines, exceptionalLines, ring; sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring); return conicLines; }
float sdf_exceptionalLines(vec3 p){ float surface, pairLines, conicLines, exceptionalLines, ring; sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring); return exceptionalLines; }
float sdf_ring(vec3 p){ float surface, pairLines, conicLines, exceptionalLines, ring; sdf_surfaceGroup(p, surface, pairLines, conicLines, exceptionalLines, ring); return ring; }

void sdf_plateGroup(vec3 p, out float plate, out float checkers, out float plateLines, out float plateConics){
    vec3  q = p - PLATEGROUP_P;
    float region = plateRegion(q, PLATE_HALF);

    //the old Box subtracted its rounding from the distance, so the
    //fillet INFLATES the extents
    plate = boxDistance(q, vec3(PLATE_HALF, PLATE_THICK, PLATE_HALF)) - PLATE_ROUND;

    checkers = plateCheckerDist(q, CHECK_R, CHECK_HALF, CHECK_ROUND, CHECK_Y);

    vec3 top = q - vec3(0.0, PLATE_TOP, 0.0);
    plateLines  = max(plateLineDist(top,  PLATE_CURVE), region);
    plateConics = max(plateConicDist(top, PLATE_CURVE), region);
}

//single-region entry points, for the 4-tap normals
float sdf_plate(vec3 p){ float plate, checkers, plateLines, plateConics; sdf_plateGroup(p, plate, checkers, plateLines, plateConics); return plate; }
float sdf_checkers(vec3 p){ float plate, checkers, plateLines, plateConics; sdf_plateGroup(p, plate, checkers, plateLines, plateConics); return checkers; }
float sdf_plateLines(vec3 p){ float plate, checkers, plateLines, plateConics; sdf_plateGroup(p, plate, checkers, plateLines, plateConics); return plateLines; }
float sdf_plateConics(vec3 p){ float plate, checkers, plateLines, plateConics; sdf_plateGroup(p, plate, checkers, plateLines, plateConics); return plateConics; }

float sdf_key(vec3 p){
    return sphereDistance(p - KEY_P, KEY_RADIUS);
}

//the room SOLID is everything outside the box, so its interior is open air and
//regionAt() returns ID_NONE there
float sdf_room(vec3 p){
    return roomDistance(p - ROOM_P, ROOM_HALFSIZE);
}


//---------------------------------------------------------------------
// the bounds — the acceleration structure (sdf_Scene only; sdfAll stays exact)
//---------------------------------------------------------------------

float bound_surfaceGroup(vec3 p){
    vec3 q = p - SURFACEGROUP_P;
    return length(q) - 2.6;
}

float bound_plateGroup(vec3 p){
    vec3 q = p - PLATEGROUP_P;
    return boxDistance(q, vec3(1.2, 0.15, 1.2));
}


//---------------------------------------------------------------------
// the normals — the 4-tap of each region's own sdf, in world coordinates
//---------------------------------------------------------------------
const float NRM_E = 0.0002;

Vector normal_surface(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_surface(p + k.xyy*NRM_E) + k.yyx*sdf_surface(p + k.yyx*NRM_E)
                              + k.yxy*sdf_surface(p + k.yxy*NRM_E) + k.xxx*sdf_surface(p + k.xxx*NRM_E) ));
}

Vector normal_pairLines(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_pairLines(p + k.xyy*NRM_E) + k.yyx*sdf_pairLines(p + k.yyx*NRM_E)
                              + k.yxy*sdf_pairLines(p + k.yxy*NRM_E) + k.xxx*sdf_pairLines(p + k.xxx*NRM_E) ));
}

Vector normal_conicLines(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_conicLines(p + k.xyy*NRM_E) + k.yyx*sdf_conicLines(p + k.yyx*NRM_E)
                              + k.yxy*sdf_conicLines(p + k.yxy*NRM_E) + k.xxx*sdf_conicLines(p + k.xxx*NRM_E) ));
}

Vector normal_exceptionalLines(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_exceptionalLines(p + k.xyy*NRM_E) + k.yyx*sdf_exceptionalLines(p + k.yyx*NRM_E)
                              + k.yxy*sdf_exceptionalLines(p + k.yxy*NRM_E) + k.xxx*sdf_exceptionalLines(p + k.xxx*NRM_E) ));
}

