//---------------------------------------------------------------------
// the materials
//  material_ gives the Surface plus this object's own Medium; medium_ gives
//  only the Medium, for when the object is merely the far side
//---------------------------------------------------------------------

Medium medium_surface(vec3 p){
    Medium m = defaultMedium();
    m.ior    = 1.5;
    m.absorb = vec3(0.6, 0.1, 0.4);
    return m;
}
Material material_surface(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //glass
    m.interior = medium_surface(p);
    m.surf.transmit = 1.0;
    return m;
}

Material material_pairLines(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //metal
    m.surf.diffuse   = vec3(0.4);
    m.surf.specular  = vec3(0.4);
    m.surf.roughness = 0.4;
    m.surf.gloss     = 0.3;
    return m;
}
Medium   medium_pairLines  (vec3 p){ return defaultMedium(); }

Material material_conicLines(vec3 p, inout Vector n){
