//--- library: glsl/shapes/primitives/box.glsl ---
//----------------------------------------------------------------------------
// BOX — an axis-aligned box, `halfSize` = half-widths.
//
// glsl/shapes/ is the math-only library: plain functions of a point and some
// floats. No structs, no Frame, no Material, no at()/inside()/setData().
// Placement, materials and the region interface are emitted by the scene.
//----------------------------------------------------------------------------


// p is in the box's own coordinates (origin at the centre); halfSize = half-widths
float boxDistance(vec3 p, vec3 halfSize){
    return bBox(p, halfSize);
}


// Exact ray intersection, in world coordinates: the nearest slab crossing in
// front of us, or maxDist. A ray STARTING INSIDE takes the far exit — glass
// needs that, since a transmitted ray has to find the far wall of the box it
// just entered.
float boxTrace(Vector tv, vec3 centre, vec3 halfSize){
    vec3  o   = tv.pos - centre;
    vec3  inv = 1.0/tv.dir;
    vec3  t1  = (-halfSize - o)*inv;
    vec3  t2  = ( halfSize - o)*inv;
    vec3  lo  = min(t1, t2);
    vec3  hi  = max(t1, t2);
    float tN  = max(lo.x, max(lo.y, lo.z));
    float tF  = min(hi.x, min(hi.y, hi.z));
    if(tN > tF || tF < 0.){ return maxDist; }   // miss, or entirely behind us
    float t = (tN > 0.) ? tN : tF;               // outside -> entry; inside -> far exit
    return min(t, maxDist);
}


//--- the objects, in declaration order (= containment priority, inner to outer)
const int ID_CUBE = 0;

const int N_OBJ = 1;
float gSDF[N_OBJ];


//--- placement and shape parameters ----------------------------------
const vec3 CUBE_P        = vec3(0.0);
const vec3 CUBE_HALFSIZE = vec3(1.8);


//---------------------------------------------------------------------
// the media — a per-region varying index the ODE marcher bends light through
//---------------------------------------------------------------------

float indexField_cube(vec3 q){
    return pow(1.0 + mass/max(length(q), 1e-4), 2.0);
}

bool isMedium(int id){ return id == ID_CUBE; }

float indexFieldOf(int id, vec3 p){
    if(id == ID_CUBE){ return indexField_cube(p - CUBE_P); }
    return 1.0;   //not a medium: vacuum
}


//---------------------------------------------------------------------
// the region sdfs
//---------------------------------------------------------------------

float sdf_cube(vec3 p){
    return boxDistance(p - CUBE_P, CUBE_HALFSIZE);
}


//---------------------------------------------------------------------
// the normals — the 4-tap of each region's own sdf, in world coordinates
//---------------------------------------------------------------------
const float NRM_E = 0.0002;

Vector normal_cube(vec3 p){
    vec2 k = vec2(1.0,-1.0)*0.5773;
    return Vector(p, normalize( k.xyy*sdf_cube(p + k.xyy*NRM_E) + k.yyx*sdf_cube(p + k.yyx*NRM_E)
                              + k.yxy*sdf_cube(p + k.yxy*NRM_E) + k.xxx*sdf_cube(p + k.xxx*NRM_E) ));
}


//---------------------------------------------------------------------
// the materials
//  material_ gives the Surface plus this object's own Medium; medium_ gives
//  only the Medium, for when the object is merely the far side
//---------------------------------------------------------------------

Medium medium_cube(vec3 p){
    Medium m = defaultMedium();
    m.ior    = indexField_cube(p - CUBE_P);
    m.absorb = vec3(0.0);
    return m;
}
Material material_cube(vec3 p, inout Vector n){
    Material m = defaultMaterial();      //glass
    m.interior = medium_cube(p);
    m.surf.transmit = 1.0;
    return m;
}


//---------------------------------------------------------------------
// the dispatchers
//---------------------------------------------------------------------

void sdfAll(vec3 p){
    gSDF[ID_CUBE] = sdf_cube(p);
}

Vector normalOf(int id, vec3 p){

    return normal_cube(p);
}

//no sheets in this scene: every object is a region with an interior
bool isSheet(int id){ return false; }

Material materialOf(int id, vec3 p, inout Vector n, bool front){

    return material_cube(p, n);
}

Medium mediumOf(int id, vec3 p){
    if(id == ID_CUBE){ return medium_cube(p); }
    return defaultMedium();      //ID_NONE: open air
}


//---------------------------------------------------------------------
// the entry points
//---------------------------------------------------------------------

void buildScene(){}

float sdf_Scene(Vector tv){
    vec3 p = tv.pos;
    float d = maxDist;

    d = min(d, sdf_cube(p));

    return d;
}

float trace_Scene(Vector tv){
    return maxDist;
}
